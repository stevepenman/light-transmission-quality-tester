* {
    font-family: "Segoe UI";
    color: #102235;
}

QWidget#applicationRoot {
    background: #eef3f7;
}

QFrame#appHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0a2036, stop:0.68 #103b59, stop:1 #0b4a59);
    border-bottom: 1px solid rgba(255,255,255,28);
}

QLabel#appIcon {
    color: white;
    background: #0f78ff;
    border: 1px solid #45b7e8;
    border-radius: 11px;
    font-size: 11px;
    font-weight: 900;
}
QLabel#appTitle { color: white; font-size: 16px; font-weight: 800; }
QLabel#appSubtitle { color: #9fb4c5; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
QLabel#systemState { color: #c9fff0; font-size: 10px; font-weight: 800; }
QLabel#systemState[state="measuring"] { color: #fbd895; }
QLabel#systemState[state="error"] { color: #ffc3c8; }
QLabel#headerLogo { background: white; border-radius: 8px; padding: 2px; }

QFrame#premiumCard, QFrame#sensorCard, QFrame#cavitySelector,
QFrame#resultCard, QFrame#guidanceCard {
    background: white;
    border: 1px solid #dbe4ec;
    border-radius: 15px;
}

QLabel#eyebrow, QLabel#selectorHeading {
    color: #087e7e;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
}
QLabel#pageTitle { color: #102235; font-size: 20px; font-weight: 900; }
QLabel#sectionTitle { color: #102235; font-size: 14px; font-weight: 800; }
QLabel#helperText { color: #6a788a; font-size: 9px; }

QPushButton {
    min-height: 38px;
    border: 1px solid #dbe4ec;
    border-radius: 10px;
    background: white;
    color: #102235;
    padding: 0 10px;
    font-size: 10px;
    font-weight: 800;
}
QPushButton:pressed { background: #e8f3ff; border-color: #8dbcf0; }
QPushButton:disabled { background: #e8edf1; color: #9ca9b5; border-color: #d7dfe5; }
QPushButton[role="primary"] { background: #0a2036; color: white; border: none; }
QPushButton[role="blue"] { background: #0f78ff; color: white; border: none; }
QPushButton[role="danger"] { background: #fff8f8; color: #d94a55; border-color: #f0c6ca; }

QPushButton#startButton {
    min-width: 98px; max-width: 98px; min-height: 98px; max-height: 98px;
    border-radius: 31px;
    border: 2px solid #63adff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1689ff, stop:0.6 #0068ec, stop:1 #0054cb);
    color: white; font-size: 19px; font-weight: 900;
}
QPushButton#startButton:pressed { background: #0054cb; }
QPushButton#startButton:disabled { background: #6f899f; border-color: #9aafbf; color: #e8eef3; }

QLabel#statusPill {
    border-radius: 13px; padding: 3px 9px; font-size: 9px; font-weight: 900;
    background: #edf1f4; color: #637385; border: 1px solid #d9e1e7;
}
QLabel#statusPill[state="ready"], QLabel#statusPill[state="pass"] { background:#e9f7f1; color:#15966c; border-color:#c4e9da; }
QLabel#statusPill[state="info"] { background:#ebf4ff; color:#1269c9; border-color:#d0e3fb; }
QLabel#statusPill[state="warning"], QLabel#statusPill[state="measuring"] { background:#fff6e6; color:#a96908; border-color:#efd39c; }
QLabel#statusPill[state="fail"], QLabel#statusPill[state="error"] { background:#fff0f1; color:#d94a55; border-color:#f2c5c9; }

QFrame#cavitySelector { background: #f8fafc; border-radius: 12px; }
QLabel#selectorLabel { color: #6a788a; font-size: 9px; font-weight: 800; }
QLabel#currentCavity { color:#1269c9; background:#ebf4ff; border:1px solid #d0e3fb; border-radius:9px; padding:2px 8px; font-weight:900; }
QPushButton#choiceButton { min-height: 32px; padding: 0; border-radius: 8px; background: white; }
QPushButton#choiceButton:checked { background:#e8f3ff; color:#086bd9; border-color:#96c7ff; }

QFrame#sensorCard { background: #f7f9fb; border-radius: 11px; }
QFrame#sensorCard[state="pass"] { background: #f0faf6; border-color: #c4e9da; }
QFrame#sensorCard[state="warning"], QFrame#sensorCard[state="measuring"] { background: #fff9ed; border-color: #efd39c; }
QFrame#sensorCard[state="fail"], QFrame#sensorCard[state="error"] { background: #fff5f6; border-color: #f2c5c9; }
QLabel#sensorName { color: #6a788a; font-size: 10px; font-weight: 700; }
QLabel#sensorValue { color: #102235; font-size: 21px; font-weight: 900; }
QLabel#sensorUnit { color: #6a788a; font-size: 9px; font-weight: 700; padding-bottom: 3px; }
QLabel#sensorDot { background: #b9c5d1; border-radius: 4px; }
QLabel#sensorDot[state="pass"] { background: #15966c; }
QLabel#sensorDot[state="warning"], QLabel#sensorDot[state="measuring"] { background: #c57a08; }
QLabel#sensorDot[state="fail"], QLabel#sensorDot[state="error"] { background: #d94a55; }
QProgressBar#sensorMeter { border: none; border-radius: 2px; background: #e1e8ee; }
QProgressBar#sensorMeter::chunk { border-radius: 2px; background: #0f78ff; }
QProgressBar#sensorMeter[state="pass"]::chunk { background: #15966c; }
QProgressBar#sensorMeter[state="warning"]::chunk { background: #c57a08; }
QProgressBar#sensorMeter[state="fail"]::chunk, QProgressBar#sensorMeter[state="error"]::chunk { background: #d94a55; }

QProgressBar#batchProgress { min-height: 7px; max-height: 7px; border: none; border-radius: 3px; background: #e4eaf0; }
QProgressBar#batchProgress::chunk { border-radius: 3px; background: #0f78ff; }

QFrame#bottomNavigation { background: white; border-top: 1px solid #dbe4ec; }
QPushButton#navButton { border: none; border-radius: 10px; background: transparent; color: #758396; padding: 2px; font-size: 9px; }
QPushButton#navButton:checked { background: #edf5ff; color: #0f70e7; }
QPushButton#navButton:disabled { color: #aab4bd; background: transparent; }

QLineEdit, QTextEdit {
    min-height: 38px; border: 1px solid #dbe4ec; border-radius: 9px;
    background: #f6f8fa; padding: 0 9px; font-size: 10px; selection-background-color: #0f78ff;
}
QTextEdit { padding: 7px 9px; }
QLineEdit:focus, QTextEdit:focus { border: 2px solid #78b8ff; background: white; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 12px; background: #edf1f4; margin: 0; }
QScrollBar::handle:vertical { min-height: 32px; background: #9babb9; border-radius: 5px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QWidget#historyRow { background: white; border-bottom: 1px solid #edf1f4; }
QLabel#historyResult[state="pass"] { color: #15966c; font-weight: 900; }
QLabel#historyResult[state="fail"] { color: #d94a55; font-weight: 900; }
QLabel#historyResult[state="warning"] { color: #a96908; font-weight: 900; }

QDialog { background: #eef3f7; }
QMessageBox { background: #eef3f7; }
QMessageBox QLabel { min-width: 260px; font-size: 11px; }
QMessageBox QPushButton { min-width: 88px; min-height: 44px; }
